# Copy to .env.local for local settings. Every variable is optional when running on your own machine.
# See the README's "Environment variables" table for details. Preferences like your name are on the app's Settings page.

# The password for the first sign-in, which creates your account. Required on any host others can reach;
# leave unset for local-only use (no sign-in at all).
BOOKBOX_PASSWORD=
# Signs the sign-in cookie. Defaults to the password; set a long random string on a hosted copy.
BOOKBOX_SECRET=
# A separate database for accounts (optional; otherwise they're kept in the library's database).
ACCOUNTS_DATABASE_URL=
ACCOUNTS_AUTH_TOKEN=
# A Turso Platform API token, your organization and group, so invited people get a database of their own.
# Without them (on your own computer), their libraries are files in DATA_DIR/libraries.
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_GROUP=
# Where the local SQLite database and covers live. Defaults to ./data
DATA_DIR=

# Hosted setup (see README > Deploy your own). Without these, the database and covers live in DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Cover storage: a Cloudflare R2 bucket (preferred) or a private Vercel Blob store.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BLOB_READ_WRITE_TOKEN=
# The day of the month the storage billing period starts (default 1); usage pauses at 80% of the free tier.
STORAGE_CYCLE_DAY=

# Spotify app keys (optional; usually entered in the app under Settings > Spotify instead).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
