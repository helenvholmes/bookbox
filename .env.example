# Required when the app is reachable from the internet. Leave unset for local-only use.
BOOKBOX_PASSWORD=
# Optional: signs the session cookie. Defaults to the password.
BOOKBOX_SECRET=
# Where the SQLite database and covers live. Defaults to ./data
DATA_DIR=
# Hosted setup (see README > Deploying). Without these, the database and covers live in DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
